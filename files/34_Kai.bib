@article{10.1021/jacs.6c04794,
    author = {Zhang, Wei-Jie and Pan, Yi-Lin and Bi, Wen-Hui and Ronson, Tanya K. and Schneider, Laura and Clever, Guido H. and Vinković, Mladen and Duez, Quentin and Su, Cheng-Yong and Nitschke, Jonathan R. and Wu, Kai},
    title = {Guest-Programmed
Adaptive Redistribution in Heteroleptic
Metal–Organic Cages},
    journal = {Journal of the American Chemical Society},
    year = {2026},
    month = {11},
    abstract = {Adaptive reconfiguration
of complex supramolecular assemblies remains
a fundamental challenge in synthetic chemistry, especially for heteroleptic
systems prone to kinetic traps and component scrambling. Here, we
report a guest-coupled reassembly strategy that enables programmable
redistribution between cage architectures in heteroleptic pentagonal
prismatic ZnII cages, assembled via precise edge-length
matching between pentatopic and tetratopic ligands. Distinct from
conventional single-guest templation, these cages exhibit adaptive
redistribution behavior in which multiguest recognition is coupled
to host redistribution within confined cavities. Chlorinated guests
are selectively encapsulated through Cl···π and
π···π interactions, thereby biasing the
thermodynamic landscape of assembly. Secondary guests redirect the
assembly equilibrium toward distinct product distributions, including
guest release, guest exchange, or stoichiometry-dependent formation
of species assigned as a homoleptic pseudo-cubic
cage with one or two encapsulated guests. Crystallographic, Hirshfeld
surface, and computational analyses reveal that multiple Cl···π,
π···π, and C–H···π
noncovalent interactions within the confined cavity contribute to
the selectivity of guest-directed assembly redistribution. Furthermore,
the incorporation of peripheral pyrene units imparts the prismatic
cages with photoluminescence, which is enhanced upon guest binding
due to framework rigidification. This work demonstrates how confined
multiguest recognition can be coupled to compositional redistribution
within complex heteroleptic assemblies, providing a foundation for
programmable adaptive supramolecular systems.},
    issn = {0002-7863},
    doi = {10.1021/jacs.6c04794},
    url = {https://doi.org/10.1021/jacs.6c04794},
    eprint = {https://pubs.acs.org/jacsat/article-pdf/doi/10.1021/jacs.6c04794/69050276/jacs.6c04794.pdf},
}



